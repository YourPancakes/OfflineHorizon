# Server-side configuration. Never store a GitHub token here.
# Both services use read-only bind mounts under ./secrets/, not environment secrets.
# On VPS: create github_sync_token (UID/GID 10001, mode 0600) from the
# existing root-owned github_release_token (mode 0600), as documented in README.
# Keep automatic source publication disabled while fork builds cannot be
# independently compiled and verified on each required platform.
SYNC_PUBLISH=0
